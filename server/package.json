{
  "name": "EdfReady",
  "version": "1.0.0",
  "private": true,
  "description": "Stateless Express proxy that forwards EDF source documents to the Gemini API for structured extraction. No DB, no file persistence, no login.",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "multer": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  }
}
