# AI provider: gemini or openrouter
AI_PROVIDER=openrouter


# OpenRouter key and model (Gemini via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Port the Express server (API + static frontend) listens on
PORT=3001

# Origin allowed to call the API when the frontend is NOT served by this same
# server (e.g. opened via a separate dev server / Live Server). Same-origin
# requests (the default setup) don't need this.
FRONTEND_ORIGIN=http://localhost:3001

# Max extraction requests per IP per 15 minutes (protects the free Gemini quota)
RATE_LIMIT_MAX=30

# Private IDFC form at /clients/idfc (browser password popup). The route is disabled if no password is set.
IDFC_ACCESS_USER=idfc
IDFC_ACCESS_PASSWORD=change_me
